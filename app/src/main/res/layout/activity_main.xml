<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    android:background="@color/pureBlack"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Root container with scroll support to handle smaller screens -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- App Title -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvTitle"
            android:text="Budgetly"
            android:textStyle="bold"
            android:textColor="@color/brandYellow"
            android:textSize="22sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Card 1: Mortgage calculation section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMortgage"
            android:layout_marginTop="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/nearBlack"
            app:strokeColor="@color/brandYellowDark"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Section label -->
                <com.google.android.material.textview.MaterialTextView
                    android:text="Mortgage"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <!-- Loan amount input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilLoan"
                    android:hint="Loan Amount ($)"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLoan"
                        android:inputType="numberDecimal"
                        android:textColor="@color/white"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Interest rate input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRate"
                    android:hint="Interest Rate (% / year)"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRate"
                        android:inputType="numberDecimal"
                        android:textColor="@color/white"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Loan tenure input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilYears"
                    android:hint="Tenure (years)"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etYears"
                        android:inputType="number"
                        android:textColor="@color/white"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Button to calculate EMI -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCalcEmi"
                    android:text="Calculate EMI"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <!-- Result display for EMI -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvEmi"
                    android:text="EMI: $0.00"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 2: Monthly budget section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBudget"
            android:layout_marginTop="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/nearBlack"
            app:strokeColor="@color/brandYellowDark"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/cardMortgage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Section label -->
                <com.google.android.material.textview.MaterialTextView
                    android:text="Monthly Budget"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <!-- Monthly income input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilIncome"
                    android:hint="Monthly Income ($)"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etIncome"
                        android:inputType="numberDecimal"
                        android:textColor="@color/white"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Monthly expenses input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilExpenses"
                    android:hint="Monthly Expenses ($)"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etExpenses"
                        android:inputType="numberDecimal"
                        android:textColor="@color/white"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Explicit intent: open detailed expenses screen -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManageExpenses"
                    android:text="Add more Expenses"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <!-- Button to calculate savings or deficit -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnComputeBudget"
                    android:text="Compute Savings / Deficit"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <!-- Result display for savings/deficit -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvBudget"
                    android:text="Result: $0.00 (Savings)"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>